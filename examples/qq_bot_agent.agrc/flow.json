{
  "version": "1.0.0",
  "nodes": [
    {
      "id": "qq_listener",
      "type": "Plugin",
      "label": "QQ事件监听",
      "config": {
        "plugin": "qq",
        "function": "QQ_Event_Plugin"
      }
    },
    {
      "id": "trigger",
      "type": "Trigger",
      "label": "接收事件"
    },
    {
      "id": "user_history",
      "type": "Prompt_Builder",
      "label": "构建对话",
      "config": {
        "history": "qq_history",
        "max_history": 100
      }
    },
    {
      "id": "llm_task",
      "type": "LLM_Task",
      "label": "LLM 对话",
      "config": {
        "provider": "deepseek",
        "model": "deepseek-chat",
        "system_prompt": "你是一个友好的 QQ 机器人助手。",
        "temperature": 0.7
      }
    },
    {
      "id": "join",
      "type": "Join",
      "label": "合并数据",
      "config": {
        "strategy": "merge"
      }
    },
    {
      "id": "send_reply",
      "type": "Plugin",
      "label": "发送回复",
      "config": {
        "plugin": "qq_reply",
        "function": "QQ_Reply_Operator"
      }
    },
    {
      "id": "log_output",
      "type": "Log",
      "label": "输出日志"
    },
    {
      "id": "assistant_history",
      "type": "Prompt_Builder",
      "label": "构建对话",
      "config": {
        "history": "qq_history",
        "max_history": 100
      }
    }
  ],
  "edges": [
    {
      "source": "qq_listener",
      "target": "trigger"
    },
    {
      "source": "trigger",
      "sourcePort": "message",
      "target": "user_history",
      "targetPort": "user"
    },
    {
      "source": "user_history",
      "sourcePort": "messages",
      "target": "llm_task",
      "targetPort": "messages"
    },
    {
      "source": "trigger",
      "target": "join"
    },
    {
      "source": "llm_task",
      "target": "join"
    },
    {
      "source": "join",
      "sourcePort": "trigger_user_id",
      "target": "send_reply",
      "targetPort": "user_id"
    },
    {
      "source": "join",
      "sourcePort": "trigger_message_type",
      "target": "send_reply",
      "targetPort": "message_type"
    },
    {
      "source": "join",
      "sourcePort": "trigger_group_id",
      "target": "send_reply",
      "targetPort": "group_id"
    },
    {
      "source": "join",
      "sourcePort": "llm_task_response",
      "target": "send_reply",
      "targetPort": "message"
    },
    {
      "source": "llm_task",
      "sourcePort": "response",
      "target": "log_output",
      "targetPort": "data"
    },
    {
      "source": "llm_task",
      "sourcePort": "response",
      "target": "assistant_history",
      "targetPort": "assistant"
    },
    {
      "source": "assistant_history",
      "target": "trigger"
    }
  ]
}